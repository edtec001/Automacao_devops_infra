Vagrant.configure("2") do |config|
  config.vm.provision "shell", inline: "echo Config docker swarm cluster" 
  config.vm.box = "eurolinux-vagrant/rocky-9"
  config.vm.box_version = "9.4.5" 
  config.vm.define "manager" do |manager|
  worker1.network "private_network", ip: "192.168.2.15"
   
  end
  config.vm.define "worker1" do |worker1|
    worker1.hostname = "worker1"
    worker1.network "private_network", ip: "192.168.2.16"
    worker1.synced_folder ".", "/vagrant", 
     
    
  end 

  config.vm.define "worker2" do |worker2|
    worker2.hostname = "worker2"
    worker2.network "private_network", ip: "192.168.2.17"
    worker2.synced_folder ".", "/vagrant", 
     
    
    mount_options: ["rw", "tcp", "nolock"]
    worker2.provision "shell", path: "provision.sh" 
  end 
  
  
    
   